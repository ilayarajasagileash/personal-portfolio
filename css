/* Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* Base */
body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
    background-color: #f5f5f5;
    color: #222;
}

/* Header */
header {
    background-color: #222;
    padding: 20px;
}

/* Navigation */
nav {
    max-width: 1100px;
    margin: auto;
    display: flex;
    justify-content: center;
    gap: 25px;
}

nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

nav a:hover,
nav a:focus {
    text-decoration: underline;
}

/* Main */
main {
    max-width: 1100px;
    margin: 40px auto;
    padding: 20px;
}

/* Headings */
h1 {
    font-size: 40px;
    margin-bottom: 20px;
}

h2 {
    margin-bottom: 10px;
}

/* Sections */
section,
article {
    background-color: white;
    padding: 25px;
    margin-bottom: 25px;
    border-radius: 8px;
}

/* Lists */
ul {
    padding-left: 25px;
}

/* Contact form */
form {
    max-width: 600px;
    background-color: white;
    padding: 25px;
    border-radius: 8px;
}

form div {
    margin-bottom: 20px;
}

label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
}

input,
textarea {
    width: 100%;
    padding: 12px;
    font-size: 16px;
    border: 1px solid #777;
    border-radius: 4px;
}

button {
    padding: 12px 20px;
    font-size: 16px;
    cursor: pointer;
}

/* Keyboard focus */
a:focus,
input:focus,
textarea:focus,
button:focus {
    outline: 3px solid #005fcc;
    outline-offset: 2px;
}

/* Footer */
footer {
    text-align: center;
    background-color: #222;
    color: white;
    padding: 20px;
    margin-top: 40px;
}

/* Mobile */
@media (max-width: 600px) {

    nav {
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    h1 {
        font-size: 32px;
    }

    main {
        margin: 20px auto;
    }
}
.skip-link {
    position: absolute;
    left: -9999px;
    top: 10px;
    padding: 10px 15px;
    background: white;
    color: black;
    z-index: 1000;
}

.skip-link:focus {
    left: 10px;
}
@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
        scroll-behavior: auto;
        animation-duration: 0.01ms;
        animation-iteration-count: 1;
        transition-duration: 0.01ms;
    }

}